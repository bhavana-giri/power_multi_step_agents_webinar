# ===================================================
#  YOU FILL THESE IN
# ===================================================

# OpenAI
OPENAI_API_KEY=
# Optional: custom gateway / proxy base URL. Leave blank for api.openai.com.
OPENAI_BASE_URL=

# Redis Cloud database (used by the Primitive Memory mode / RedisVL)
# e.g. redis://default:<password>@<host>:<port>  (rediss:// if TLS)
REDIS_URL=

# Redis Agent Memory (used by the Real-time Context Engine mode)
# From the Redis Cloud console → Agent Memory
MEMORY_API_BASE_URL=
MEMORY_STORE_ID=
MEMORY_API_KEY=

# ===================================================
#  DEFAULTS (change only if needed)
# ===================================================

OPENAI_CHAT_MODEL=gpt-4o
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Identity used to scope memories
DEMO_USER_ID=demo-user
MEMORY_NAMESPACE=agent-memory-demo
MEMORY_ACTOR_ID=memory-demo-agent

# Retrieval knobs
MEMORY_SIMILARITY_THRESHOLD=0.3
MEMORY_LIMIT=6
PRIMITIVE_RECENT_WINDOW=8
PRIMITIVE_DISTANCE_THRESHOLD=0.35

BACKEND_PORT=8060
